[Unit]
Description=Publish the Community Archive nightly digest
After=network-online.target
Wants=network-online.target
# Five starts over 80 minutes, then give up until the next timer run.
StartLimitIntervalSec=2h
StartLimitBurst=5

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/community-archive-nightly-digest
EnvironmentFile=/etc/community-archive-nightly-digest.env
ExecStart=/root/.bun/bin/bun /opt/community-archive-nightly-digest/services/nightly-digest/publish.ts
TimeoutStartSec=20min
# A retry never repeats a model call: published dates skip, completed runs only
# publish, and a failed generation stops at its saved run.
Restart=on-failure
RestartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
