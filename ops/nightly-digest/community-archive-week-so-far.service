[Unit]
Description=Refresh the Community Archive week-so-far digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/community-archive-nightly-digest
EnvironmentFile=/etc/community-archive-nightly-digest.env
ExecStart=/root/.bun/bin/bun /opt/community-archive-nightly-digest/services/nightly-digest/publishWeekly.ts --week-so-far
# Two model calls, each of which may retry once with a longer limit.
TimeoutStartSec=30min
# No automatic restart: the next morning's run (after a new daily) catches up,
# and a run for the same day never repeats its model call.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
