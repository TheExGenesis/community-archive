# Connection to the database the worker is responsible for. Should point
# at PROD when deployed to Hetzner (or STAGING for the staging-bound
# replica). The worker only uses a single connection at a time, so the
# pooler URL is the right choice.
#
# IMPORTANT: ca-autorefresh (and most Hetzner shared instances) has no
# IPv6 connectivity, and the direct host `db.<ref>.supabase.co` is
# IPv6-only. You MUST use the IPv4 pooler URL on Hetzner, e.g.
#   postgres://postgres.<ref>:<password>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
# The region prefix matches the Supabase project's region — check the
# project's "Connection string" page in Supabase Studio if unsure
# (rorqwtqinelsbxtfexsh → us-west-1 today).
DATABASE_URL=

# Storage bucket access. The worker uses the service-role JWT (not the
# DATABASE_URL) for private raw-object deletion and ID-only manifests because
# buckets goes through PostgREST/storage-api.
SUPABASE_URL=https://fabxmporizzqflnftavs.supabase.co
SUPABASE_SERVICE_ROLE=

# How often the polling loop wakes up to look for new QUEUED jobs.
# Lower = faster pickup, more idle DB chatter. 10s is fine for human-
# initiated admin deletes; bump to 60s if jobs are rare.
POLL_INTERVAL_MS=10000

# Optional: override the hostname recorded in private.worker_runs.host.
# Defaults to os.hostname(). Useful when multiple workers run from the
# same container image and you want them distinguishable.
WORKER_HOST_LABEL=

# Optional: log level for pino. Default 'info'. Set 'debug' to see every
# poll cycle, 'warn' to suppress per-job heartbeats.
LOG_LEVEL=info

# Disabled additive canonical tombstone copy. The existing PostgreSQL policy
# tombstone, raw-object cleanup, job result, and worker acknowledgement remain
# authoritative when this is false or publication fails.
CANONICAL_ADMIN_DELETE_SHADOW_PUBLISH_ENABLED=false
CANONICAL_PUBLISH_URL=https://firehose-host/internal/canonical-ingest
CANONICAL_PUBLISHER_API_KEY=replace-with-dedicated-runtime-secret
CANONICAL_PUBLISH_BATCH_SIZE=100
CANONICAL_PUBLISH_TIMEOUT_SECONDS=30
