# The Docker build context is the repository root, so service-local paths must
# be explicit. Docker only discovers this file when it is named after the
# non-root Dockerfile.

# Logs, data and lock files
services/process_archive/logs/
services/process_archive/data/
*.log
*.lock
*.pid

# Environment files
.env
.env.local
.env.*.local

# Node modules (will be installed in container)
node_modules/
services/process_archive/node_modules/

# Git
.git/
.gitignore

# Documentation
README*.md
services/process_archive/DEPLOY.md
*.md

# Development files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
