{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "src/app/**/*": {
      "maxDuration": 15
    },
    "src/app/api/agent-search/*/stream/route.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/digest-email",
      "schedule": "0 10 * * *"
    }
  ]
}
